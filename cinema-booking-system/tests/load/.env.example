# Keycloak Admin Client Secret for Identity Service integration
KC_ADMIN_CLIENT_SECRET=your_keycloak_admin_client_secret_here

# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=cinema_db

# Keycloak admin credentials
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# RabbitMQ credentials
RABBITMQ_DEFAULT_USER=cinema
RABBITMQ_DEFAULT_PASS=guest

# Internal service communication token
INTERNAL_API_TOKEN=local-dev-internal-token

# ASP.NET Core port configuration (force port 80 instead of .NET 8 default 8080)
ASPNETCORE_URLS=http://+:80
ASPNETCORE_HTTP_PORTS=80

# Load test rate limit configuration (raise from default 300 to 10,000 req/min)
RATE_LIMIT_GLOBAL_PERMIT_LIMIT=10000
RATE_LIMIT_GLOBAL_QUEUE_LIMIT=100


