# ==============================================================================
# CINEMA BOOKING SYSTEM - INFRASTRUCTURE ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy this file to .env and modify values as needed for local development.
# Split into clear sections to prevent typos and configuration mismatches.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ASP.NET CORE / GENERAL SERVICE SETTINGS
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default credentials for PostgreSQL container and downstream connection strings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cinema_db

# Microservice Database Names (Created automatically by init-dbs.sh)
KEYCLOAK_DB_NAME=keycloak_db
USER_PROFILE_DB_NAME=user_profile_db
FACILITY_DB_NAME=facility_db
CATALOG_DB_NAME=catalog_db
SHOWTIME_DB_NAME=showtime_db
BOOKING_DB_NAME=booking_db
PAYMENT_DB_NAME=payment_db

# ------------------------------------------------------------------------------
# 3. REDIS CACHE CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECTION_STRING=redis:6379

# ------------------------------------------------------------------------------
# 4. RABBITMQ MESSAGE BROKER CONFIGURATION
# ------------------------------------------------------------------------------
# Unified credentials shared across RabbitMQ container, Keycloak SPI, and C# consumers/publishers
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ------------------------------------------------------------------------------
# 5. KEYCLOAK IDENTITY PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_DB_TYPE=postgres
KC_PORT=8080
KC_BASE_URL=http://keycloak:8080
KC_AUTHORITY_URL=http://keycloak:8080/realms/cinema-booking

# ------------------------------------------------------------------------------
# 6. INTERNAL MICROSERVICE URLS (REVERSE PROXY & HTTP CLIENTS)
# ------------------------------------------------------------------------------
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
IDENTITY_SERVICE_INTERNAL_URL=http://identity-service:80
FACILITY_SERVICE_INTERNAL_URL=http://facility-service:80

# ------------------------------------------------------------------------------
# 7. SERVICE EXPOSED PORTS (HOST PORTS)
# ------------------------------------------------------------------------------
API_GATEWAY_PORT=5000
IDENTITY_SERVICE_PORT=5001
FACILITY_SERVICE_PORT=5002
