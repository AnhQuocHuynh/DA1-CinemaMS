# ==============================================================================
# CINEMA BOOKING SYSTEM - INFRASTRUCTURE ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy this file to .env and modify values as needed for local development.
# Split into clear sections to prevent typos and configuration mismatches.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ASP.NET CORE / GENERAL SERVICE SETTINGS
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:80

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default credentials for PostgreSQL container and downstream connection strings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cinema_db

# Microservice Database Names (Created automatically by init-dbs.sh/sql)
KEYCLOAK_DB_NAME=keycloak_db
USER_PROFILE_DB_NAME=user_profile_db
FACILITY_DB_NAME=facility_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db
CATALOG_DB_NAME=cinema_catalog_db
SHOWTIME_DB_NAME=cinema_showtime_db
BOOKING_DB_NAME=cinema_booking_db
ANALYTICS_DB_NAME=cinema_analytics_db

# ------------------------------------------------------------------------------
# 3. REDIS CACHE CONFIGURATION
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECTION_STRING=redis:6379
SHOWTIME_REDIS_HOST=showtime-redis
SHOWTIME_REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. RABBITMQ MESSAGE BROKER CONFIGURATION
# ------------------------------------------------------------------------------
# Unified credentials shared across RabbitMQ container, Keycloak SPI, and C# consumers/publishers
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_PASSWORD=guest

# ------------------------------------------------------------------------------
# 5. KEYCLOAK IDENTITY PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_DB_TYPE=postgres
KC_PORT=8080
KC_BASE_URL=http://keycloak:8080
KC_AUTHORITY_URL=http://keycloak:8080/realms/cinema-booking

# ------------------------------------------------------------------------------
# 6. NEO4J GRAPH DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_PASSWORD=cinema_graph_2026


# ------------------------------------------------------------------------------
# 7. SERVICE EXPOSED PORTS (HOST PORTS)
# ------------------------------------------------------------------------------
API_GATEWAY_PORT=5000
IDENTITY_SERVICE_PORT=5001
FACILITY_SERVICE_PORT=5002
PAYMENT_SERVICE_PORT=5003

# ------------------------------------------------------------------------------
# 8. SPRING BOOT SECURITY & INTERNAL CONFIGURATION
# ------------------------------------------------------------------------------
INTERNAL_API_TOKEN=local-dev-internal-token
CINEMA_SECURITY_JWT_ENABLED=false
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/cinema-booking
KEYCLOAK_AUDIENCE=cinema-api
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/cinema-booking/protocol/openid-connect/certs

# ------------------------------------------------------------------------------
# 9. PAYMENT SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
Stripe__SecretKey=your_stripe_secret_key_here
Stripe__WebhookSecret=your_stripe_webhook_secret_here
PayPal__ClientId=your_paypal_client_id_here
PayPal__ClientSecret=your_paypal_client_secret_here
PayPal__Mode=sandbox
